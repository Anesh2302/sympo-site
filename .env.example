# ── Zyverse 2K26 environment keys ──────────────────────────────────
# Local:  copy this file to .env  (never commit .env itself)
# Cloud:  Vercel → your project → Settings → Environment Variables
#         (add the same three keys, then Redeploy)
#
# Until SUPABASE_URL + SUPABASE_SERVICE_KEY exist, local dev stores
# registrations in data/registrations.json — production requires
# Supabase (see database/schema.sql).

# Create a free project at https://supabase.com
# Then: Project Settings → API → copy both values:
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-secret-key

# Admin key used by /admin.html and GET /api/registrations?key=...
ADMIN_KEY=zyverse2026